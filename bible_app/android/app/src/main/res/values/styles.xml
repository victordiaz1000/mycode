<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to the Android Window while the process is starting when the OS's Dark Mode setting is off -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- Show a splash screen on the activity. Automatically removed when
             the Flutter engine draws its first frame -->
        <item name="android:windowBackground">@drawable/launch_background</item>
        <!-- Les deux attributs suivants ne valent que sur Android 12+ (API 31),
             où le système ignore `windowBackground` au démarrage. Ils restent
             dans `values/` et non dans un `values-v31/` à dessein : le
             qualificatif `night` prime sur `v31` dans l'ordre de résolution des
             ressources, donc un `values-v31/` serait supplanté par
             `values-night/` en thème sombre et l'écran de démarrage d'Android 12
             perdrait sa configuration. Les versions antérieures ignorent
             simplement les attributs qu'elles ne connaissent pas. -->
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <!-- Android 12+ masque cette icône en cercle : la marque doit tenir dans
             le disque central des deux tiers. `appCodebar/generate_splash.py`
             borne sa diagonale à 60 % du canevas pour cette raison. -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
    </style>
    <!-- Theme applied to the Android Window as soon as the process has started.
         This theme determines the color of the Android Window while your
         Flutter UI initializes, as well as behind your Flutter UI while its
         running.

         This Theme is only used starting with V2 of Flutter's Android embedding. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- Une couleur plate, PAS `@drawable/launch_background` : ce fond n'est
             pas l'écran de démarrage, c'est la fenêtre derrière l'UI Flutter.
             Avec le layer-list, la marque réapparaissait à chaque passage en
             arrière-plan et au retour, en plus du fond sombre d'alors. -->
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
