<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Theme applied to the Android Window while the process is starting when the OS's Dark Mode setting is on -->
    <!-- Parent clair et non `Theme.Black.NoTitleBar` : l'écran de démarrage de
         BYM est clair dans les deux modes, et un parent sombre ferait réapparaître
         du noir partout où un attribut n'est pas explicitement redéfini. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- Show a splash screen on the activity. Automatically removed when
             the Flutter engine draws its first frame -->
        <item name="android:windowBackground">@drawable/launch_background</item>
        <!-- Mêmes valeurs qu'en thème clair : la marque est noire sur fond clair
             dans les deux cas, donc l'écran de démarrage ne change pas avec le
             mode du système. Ce doublon est nécessaire — `values-night/` remplace
             entièrement le style de même nom, il n'en hérite pas. -->
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
    </style>
    <!-- Theme applied to the Android Window as soon as the process has started.
         This theme determines the color of the Android Window while your
         Flutter UI initializes, as well as behind your Flutter UI while its
         running.

         This Theme is only used starting with V2 of Flutter's Android embedding. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- Une couleur plate, PAS `@drawable/launch_background` : ce fond n'est
             pas l'écran de démarrage, c'est la fenêtre derrière l'UI Flutter.
             Avec le layer-list, la marque réapparaissait à chaque passage en
             arrière-plan et au retour, en plus du fond sombre d'alors. -->
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
