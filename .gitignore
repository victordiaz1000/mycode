# Outils et sessions locales — pas du projet.
.claude/
.deep-copilot/

# Réglages d'éditeur, propres à cette machine.
.idea/
.vscode/

# Sorties régénérables des convertisseurs. `python md_to_json.py` reconstruit
# `appCodebar/bym_json/` depuis `appCodebar/bym_md/`, et `python sg1910_to_json.py`
# reconstruit `appCodebar/sg1910_json/` depuis `Sg1910-csv/`. Dans chaque cas les
# mêmes données existent déjà dans `bible_app/assets/` (bym/ et lsgs/) ; les copies
# intermédiaires ne portent aucune information, seulement le risque de diverger.
appCodebar/bym_json/
appCodebar/sg1910_json/

# Doublon compressé du corpus CSV source : le dossier `Sg1910-csv/` fait foi.
Sg1910-csv.zip

# Sorties régénérables de l'extraction Biblia. `python
# extraction/extract_heb_grc.py` reconstruit `extraction/HEB/` et
# `extraction/GRC/` (dumps HTML des dictionnaires + entries.json) depuis les XML
# de Biblia Universalis 3, et `python extraction/fusion_strong_v2.py` refait la
# fusion. Ce sont les scripts et les deux rapports qui portent l'information —
# pas les 14 000 pages intermédiaires, seulement le risque de diverger.
extraction/HEB/
extraction/GRC/
# Même logique pour LGS/LSS : `python extraction/extract_lgs_lss.py --rapport`
# reconstruit `extraction/LGS/` (66 JSON, 34 Mo) et `extraction/LSS/` (66 JSON,
# 41 Mo) depuis LGS.xml et LSS.xml. Le script et le rapport portent
# l'information — les deux jeux de JSON ne font que rejouer l'extraction.
extraction/LGS/
extraction/LSS/
extraction/__pycache__/
# La fusion n'est pas embarquée : elle sort dans extraction/ pour rester hors du
# bundle (le pubspec y liste assets/lexicon/ en entier). Régénérable.
extraction/strong_fr_v2.json

# Systèmes de fichiers
Thumbs.db
.DS_Store

# Note : `bible_app/` porte le .gitignore Flutter (build/, .dart_tool/, …)
# et chaque dossier de plateforme le sien (android/.gradle, ios/…).

# Modules SWORD téléchargés localement (sources régénérables, licence de distribution spécifique).
appCodebar/sword_modules/
appCodebar/__pycache__/

# Fichiers de travail / outils hors projet (voir commit 2026-08-15).
opencode.json
mcp-vision-bridge/
interfaces/
html1.html
inspect_fredaw.py
renduLexique/
rendu_ecran_cliquable_lsgstrong/

# Bases SQLite jetables d'une session de bureau.
bible_app/.freebuff/

# Sortie régénérable de l'extraction ATI. `python ATI/extract_ati.py` reconstruit
# `ATI/extrait/` depuis ATI.xml de Biblia Universalis 3 : 972 fichiers, 308 Mo
# dont 285 Mo de pages HTML brutes. C'est le script qui porte l'information.
ATI/extrait/
ATI/__pycache__/

# Même logique pour le NTI : `python NTI/extract_nti.py` reconstruit
# `NTI/extrait/` depuis NTI.xml (282 fichiers, 87 Mo de pages HTML brutes),
# et `python NTI/nti_to_json.py` refait `NTI/json/` — celui-là est versionné,
# comme `ATI/json/`, parce que c'est ce qui est publié sur -bym-bibles.
NTI/extrait/
NTI/__pycache__/
